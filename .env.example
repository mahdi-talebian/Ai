# این فایل را کپی کنید: cp .env.example .env
# سپس مقادیر زیر را با اطلاعات واقعی خودتان پر کنید.

# دامنه‌ای که سرور را از طریق آن سرو می‌کنید (باید از قبل روی IP سرور
# با یک رکورد DNS نوع A تنظیم شده باشد)
DOMAIN=example.com

# ایمیلی که Let's Encrypt برای اطلاع‌رسانی انقضای گواهی به آن پیام می‌دهد
EMAIL=you@example.com
